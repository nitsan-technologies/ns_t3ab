{
    "name": "nitsan/ns-t3ab",
    "type": "typo3-cms-extension",
    "homepage": "https://t3planet.com",
    "description": "T3AB helps you build TYPO3 content blocks, and AI-powered forms, fast and customizable. Just describe your idea, and T3AB generates clean, ready-to-use TYPO3 code with full flexibility.",
    "authors": [
        {
            "name": "Team T3Planet",
            "role": "Developer",
            "homepage": "https://t3planet.com",
            "email": "support@t3planet.com"
        }
    ],
    "keywords": [
        "TYPO3",
        "AI Builder",
        "content blocks",
        "forms"
    ],
    "support": {
        "issues": "https://t3planet.com/support"
    },
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2 <9",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
        "typo3/cms-form": "^12.4 || ^13.4 || ^14.3",
        "nitsan/ns-license": ">=14.3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "friendsoftypo3/content-blocks": "^0.7.8 || ^1.3 || ^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.2 || ^12.1",
        "typo3/cms-install": "^12.4 || ^13.4 || ^14.3",
        "typo3/testing-framework": "^8.2 || ^9.0"
    },
    "suggest": {
        "friendsoftypo3/content-blocks": "Required for AI Content Blocks module (0.7.x on TYPO3 12, 1.x on 13, 2.x on 14)"
    },
    "autoload": {
        "psr-4": {
            "NITSAN\\NsT3Ab\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NITSAN\\NsT3Ab\\Tests\\": "Tests"
        }
    },
    "scripts": {
        "cs:check": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": ".Build/bin/php-cs-fixer fix",
        "stan": ".Build/bin/phpstan analyse --memory-limit=512M",
        "test": ".Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "ci": [
            "@composer test",
            "@composer stan",
            "@composer cs:check"
        ]
    },
    "scripts-descriptions": {
        "cs:check": "Run PHP-CS-Fixer in dry-run mode (.php-cs-fixer.php)",
        "cs:fix": "Apply PHP-CS-Fixer fixes",
        "stan": "Run PHPStan static analysis (phpstan.neon)",
        "test": "Run unit tests (Build/phpunit/UnitTests.xml)",
        "ci": "Run what the GitHub Actions CI runs: unit tests, PHPStan, coding standards"
    },
    "replace": {
        "typo3-ter/ns-t3ab": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/public",
            "extension-key": "ns_t3ab"
        }
    }
}